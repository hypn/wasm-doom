# Local build output and git history aren't needed to build the image.
# (DOOM1.WAD is deliberately not ignored: the build needs it.)
.git
build
dist
**/node_modules

# Docs and repo settings: changing them shouldn't rebuild the image.
# Root level only: engine/libraries/fmt lists its own *.md as sources.
*.md
.gitignore
.gitattributes
.dockerignore
Dockerfile
docker-compose.yaml
